# Template for /etc/systemd/system/redis-sync.service. Replace @USER@ with the user that owns
# the clone and @INSTALL_DIR@ with the clone's full path (e.g. /home/<user>/Can-you-break-the-bank).
# SETUP.md has a one-line sed command that does this when installing it.
[Unit]
Description=Sync Redis Instances for PiFace1 and PiFace2
After=network-online.target redis-server.service
Wants=network-online.target
# Keep retrying (the other Pi may be off or still booting) instead of giving up after 5 quick failures
StartLimitIntervalSec=0

[Service]
User=@USER@
Group=@USER@
WorkingDirectory=@INSTALL_DIR@
ExecStart=/usr/bin/python3 @INSTALL_DIR@/redis-sync.py
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
